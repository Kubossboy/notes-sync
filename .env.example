# Copy to .env (git-ignored) and fill in ONLY on your own machine/box.
# Never paste keys into chat. All keys are optional; modules without keys
# report "needs_credentials" and degrade gracefully.

# Contact e-mail for the SEC EDGAR User-Agent header (SEC fair-access policy)
ATLAS_CONTACT_EMAIL=

# Alpaca PAPER trading (https://paper-api.alpaca.markets only - live is blocked in code)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# X (Twitter) API v2 bearer token (recent search needs a paid X tier). Without it the
# X module reports needs_credentials and ATLAS does not claim to monitor X.
X_BEARER_TOKEN=

# Optional free-tier keys - NOT used yet (no sign-ups made); reserved
FINNHUB_API_KEY=
NEWSAPI_KEY=

# Cloudflare Pages publishing of the read-only snapshot (scripts/publish.sh). Free plan, no card.
# Token scope: Account > Cloudflare Pages > Edit (nothing else). publish.sh reads these from the PROCESS
# ENVIRONMENT (export them in your shell / service), listed here only so every variable name is documented.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional runtime knobs (process env)
# ATLAS_CONFIG=config/default.yaml   # alternative config file
# INTERVAL=60                        # loop cycle seconds (scripts/run_loop.py / run_loop.sh)
