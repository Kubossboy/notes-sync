# Copy to .env (git-ignored) and fill in ONLY on your own machine/box.
# Never paste keys into chat. All keys are optional; modules without keys
# report "needs_credentials" and degrade gracefully.

# Contact e-mail for the SEC EDGAR User-Agent header (SEC fair-access policy)
ATLAS_CONTACT_EMAIL=

# Alpaca PAPER trading (https://paper-api.alpaca.markets only - live is blocked in code)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# X (Twitter) API v2 bearer token for social intelligence (milestone 4)
X_BEARER_TOKEN=

# Optional free-tier keys (milestone 4+)
FINNHUB_API_KEY=
NEWSAPI_KEY=
